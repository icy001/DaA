# ============================================================
#  .env  凭证与环境配置示例文件
# ============================================================
# 使用方法：
#   1) 把本文件复制一份命名为  .env （注意开头有个点）
#         cp .env.example .env
#   2) 填入你自己的真实凭证；未用到的可以留空
#   3)  .env  永远不要提交到任何代码仓库（已在 .gitignore 中屏蔽）
#   4) 配置变更后重启程序即可生效，不需要动 config.py
# ============================================================

# ---------- 数据平台 ----------
TUSHARE_TOKEN=
JOINQUANT_USERNAME=
JOINQUANT_PASSWORD=
UQER_TOKEN=
WIND_ACCOUNT=
CHOICE_ACCOUNT=

# ---------- 推送告警 ----------
WECHAT_WEBHOOK_KEY=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
SERVERCHAN_SENDKEY=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
ALERT_EMAIL_TO=

# ---------- A股/ETF/可转债/REITs：QMT（迅投本地端） ----------
QMT_PATH=C:/qmt_mini
QMT_ACCOUNT_ID=
QMT_PASSWORD=
QMT_SESSION_ID=123456
QMT_MODE=simulation              # mini / standard / simulation
QMT_BROKER_TYPE=stock            # stock / future

# ---------- A股/ETF/可转债：PTrade（恒生云端） ----------
PTRADE_SERVER=
PTRADE_USERNAME=
PTRADE_PASSWORD=
PTRADE_ACCOUNT_ID=

# ---------- 国内期货：CTP / SimNow ----------
CTP_FRONT_ADDR_TRADE=tcp://180.168.146.187:10130
CTP_FRONT_ADDR_MARKET=tcp://180.168.146.187:10131
CTP_BROKER_ID=9999               # SimNow 默认 9999；实盘填期货公司给的 broker_id
CTP_USER_ID=
CTP_PASSWORD=
CTP_APP_ID=simnow_client_test
CTP_AUTH_CODE=0000000000000000
CTP_PRODUCT_INFO=
CTP_PROD_CODE=

# ---------- 外盘：盈透 IBKR（仅仿真，境内身份实盘受限） ----------
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                   # TWS 实盘7496/仿真7497；IB Gateway 实盘4001/仿真4002
IBKR_CLIENT_ID=1

# ---------- 加密货币（仅学习研究用） ----------
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ---------- 实盘/仿真全局开关 ----------
LIVE_TRADING_ENABLED=false       # true=允许真实下单；false=强制走仿真/模拟
BROKER_DEFAULT=qmt               # qmt / ptrade / ctp / ibkr / paper
