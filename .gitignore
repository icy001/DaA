# ============================================================
#  多市场量化交易系统 .gitignore
# ============================================================

# ---------- 凭证与本地配置（绝不提交） ----------
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------- 运行数据与缓存（由程序自动生成） ----------
data_cache/*
logs/*
backtest_results/*
reports/*
paper_trading/*
live_trading/*
research_output/*
# 实盘合规审计日志，永久不提交
audit_logs/*

# ---------- 临时与系统文件 ----------
*.log
*.tmp
.DS_Store
Thumbs.db
